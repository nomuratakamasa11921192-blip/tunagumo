# 開発用cloneでテストを実行するときに使う環境変数のテンプレート。
#
# 使い方:
#   cp saas/.env.test.example saas/.env.test
#
# テストはAPIを実際に呼ばず、モック(tests/fakes.py)で差し替えるため、
# 本物のAPIキーは不要。ダミー値のままでテストは通る。
#
# 【重要】このファイルは本番の saas/.env とは別物。
# daily_qa.sh は必ず --env-file ../.env.test を指定して本番と分離する
# (SYSTEM_PROMPT.md §6.1 参照)。

# docker-compose.yml 側で上書きされるが、compose起動時の変数展開のために定義しておく
DATABASE_URL=postgresql+asyncpg://tsunagumo:tsunagumo_dev@db:5432/tsunagumo

# テストではモックに差し替わるのでダミーでよい
ANTHROPIC_API_KEY=test-dummy-key
ANTHROPIC_MODEL=test-model
ANTHROPIC_MODEL_LIGHT=test-model-light

# OPENAI_API_KEY は【意図的に空】にする。
# 「キー未設定なら402を返す」ことを確認するテストが3件あり
# (test_documents / test_reel_route / test_room_tour_route)、
# ダミー値を入れるとキーが有る扱いになってそれらが落ちる。
# 実際にOpenAIを使うテストはモック(tests/fakes.py)に差し替わるので空で問題ない。
OPENAI_API_KEY=

ADMIN_API_KEY=test-admin-key

# テナントの秘密情報を暗号化する鍵。テスト用に固定値でよいが、
# Fernetの形式(44文字のbase64)である必要がある。
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_SECRET_KEY=

# 通知メールはテストでは送らない
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SAAS_PUBLIC_URL=http://localhost:8000

ENV=development
