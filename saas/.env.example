DATABASE_URL=
# 2026-09-15: 文章生成をAnthropicからOpenAIへ移行。文章生成・埋め込み・音声・画像すべてこのキーを使う
OPENAI_API_KEY=
# config/*.yamlの単価表にあるモデルを指定する。変更する場合は単価表も書き換えること
# 2026-09-23: 本文・軽い処理ともGPT-6 Luna(最安のGPT-6)に変更
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_LIGHT=gpt-6-luna
# 推論モデルの思考量(none/low/medium/high)。未指定ならlow
OPENAI_REASONING_EFFORT=low

# 文章生成の提供元(2026-09-16追加)。"anthropic"(Claude) か "openai" を指定する。
# 画像生成・音声合成・文字起こし・資料検索(埋め込み)は、Claudeに同等機能が無いため常にOpenAI。
# 切り替えたら docker compose up -d で作り直すこと(restartでは反映されない)。
LLM_PROVIDER=openai
# 文章生成に使うモデル。config/*.yamlの単価表はモデル名で引くので、下記のいずれかを設定する
#   Anthropic: claude-sonnet-5(本文) / claude-haiku-4-5-20251001(振り分け等の軽い処理)
#   OpenAI:    gpt-6-luna(本文・軽い処理とも。旧: gpt-5.6-terra / gpt-5.6-luna)
LLM_MODEL=gpt-6-luna
LLM_MODEL_LIGHT=gpt-6-luna

# 国土交通省「不動産情報ライブラリ」のAPIキー(無料)。https://www.reinfolib.mlit.go.jp/api/request/ から申請する。
# 未設定の間は、価格査定・空室対策・エリア分析用の「市場データを取得」が「準備中」と表示される。
REINFOLIB_API_KEY=
# 旧設定(読まれない。切り戻し用に残している)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_LIGHT=
ADMIN_API_KEY=
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_SECRET_KEY=
# 通知メール送信(Resend https://resend.com )。未設定の間は送信をスキップするだけで動く。
RESEND_API_KEY=
# Resendで送信ドメイン認証(SPF/DKIM)したアドレス。例: "ツナグモ <notify@tsunagumo.jp>"
RESEND_FROM_EMAIL=
# 顧客がログインするSaaS本体のURL(通知メール本文のリンクに使う)
SAAS_PUBLIC_URL=
ENV=development
