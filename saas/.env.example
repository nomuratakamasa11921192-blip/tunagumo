DATABASE_URL=
# 2026-09-15: 文章生成をAnthropicからOpenAIへ移行。文章生成・埋め込み・音声・画像すべてこのキーを使う
OPENAI_API_KEY=
# config/*.yamlの単価表はこの2モデル前提。変更する場合は単価表も書き換えること
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_LIGHT=gpt-5.6-luna
# 推論モデルの思考量(none/low/medium/high)。未指定ならlow
OPENAI_REASONING_EFFORT=low

# 国土交通省「不動産情報ライブラリ」のAPIキー(無料)。https://www.reinfolib.mlit.go.jp/api/request/ から申請する。
# 未設定の間は、価格査定・空室対策・エリア分析用の「市場データを取得」が「準備中」と表示される。
REINFOLIB_API_KEY=
# 旧設定(読まれない。切り戻し用に残している)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_LIGHT=
ADMIN_API_KEY=
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_SECRET_KEY=
# 通知メール送信(Resend https://resend.com )。未設定の間は送信をスキップするだけで動く。
RESEND_API_KEY=
# Resendで送信ドメイン認証(SPF/DKIM)したアドレス。例: "ツナグモ <notify@tsunagumo.jp>"
RESEND_FROM_EMAIL=
# 顧客がログインするSaaS本体のURL(通知メール本文のリンクに使う)
SAAS_PUBLIC_URL=
ENV=development
