# 本番用.envのテンプレート。VPS上の /opt/tsunagumo/saas/.env としてこの内容をコピーする。
# 既に決まっている値は埋めてあります。埋まっていない項目は、その場で入力してください。

# --- 本番デプロイ済み(2026-08-25、VPS上の実際の.envに設定済み) ---
# デプロイが完了したので、このファイルから実際の値は削除した(平文で残すリスクを避けるため)。
# 値そのものはVPS上の /opt/tsunagumo/saas/.env にあり、ローテーションが必要な場合は
# 各サービス(TENANT_SECRET_KEYは自分で生成、ADMIN_API_KEYは任意の強い文字列、
# RESEND_API_KEYはresend.comのダッシュボード)から改めて発行すること。
TENANT_SECRET_KEY=
ADMIN_API_KEY=
RESEND_API_KEY=

# ドメイン認証(SPF/DKIM)が完了するまではこのままでよい。認証後、実際のドメインの
# アドレスに差し替える(例: "ツナグモ <notify@tunagumo.com>")
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- VPS上で埋めるもの ---
# docker-compose.ymlのdbサービスと同じ認証情報を使う場合が多い。ローカル開発の
# docker-compose.ymlを参考に、postgresql+asyncpg://ユーザー:パスワード@db:5432/DB名 の形式で
DATABASE_URL=

# ツナグモ自身のOpenAI APIキー(2026-09-15、文章生成をAnthropicから移行)。
# 文章生成・画像の生成と編集・埋め込み・音声合成・文字起こしの全てで使い、費用は運営負担。
OPENAI_API_KEY=
# config/*.yamlの単価表はこの2モデル前提。変更する場合は単価表も書き換えること
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_LIGHT=gpt-5.6-luna
# 推論モデルの思考量(none/low/medium/high)。未指定ならlow
OPENAI_REASONING_EFFORT=low

# 文章生成の提供元(2026-09-16追加)。"anthropic"(Claude) か "openai" を指定する。
# 画像生成・音声合成・文字起こし・資料検索(埋め込み)は、Claudeに同等機能が無いため常にOpenAI。
# 切り替えたら docker compose up -d で作り直すこと(restartでは反映されない)。
LLM_PROVIDER=anthropic
# 文章生成に使うモデル。config/*.yamlの単価表はモデル名で引くので、下記のいずれかを設定する
#   Anthropic: claude-sonnet-5(本文) / claude-haiku-4.5(振り分け等の軽い処理)
#   OpenAI:    gpt-5.6-terra(本文)   / gpt-5.6-luna(軽い処理)
LLM_MODEL=claude-sonnet-5
LLM_MODEL_LIGHT=claude-haiku-4.5

# 国土交通省「不動産情報ライブラリ」のAPIキー(無料)。https://www.reinfolib.mlit.go.jp/api/request/ から申請する。
# 未設定の間は、価格査定・空室対策・エリア分析用の「市場データを取得」が「準備中」と表示される。
REINFOLIB_API_KEY=

# 旧設定(読まれない。切り戻し用に残している)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001

# 2026-08-26変更: 営業サイト(tunagumo.com)とSaaS本体のドメインを分離したため、
# SaaS本体はapp.サブドメインになった(docker/Caddyfile.example参照)
SAAS_PUBLIC_URL=https://app.tunagumo.com

# バックアップ暗号化用パスフレーズ(docker/backup_db.sh・restore_db.shが使う)。
# 開発環境の.envとは別の値を、VPS上で新たに生成すること(使い回さない)。
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# このパスフレーズを失うと、暗号化したバックアップは復元できなくなるので、
# .envとは別の安全な場所(パスワードマネージャー等)にも控えを残すこと。
BACKUP_ENCRYPTION_PASSPHRASE=

# ディスク使用率警告等、運用アラートの通知先(顧客向けではなく野村さん自身の受信先)
ADMIN_NOTIFICATION_EMAIL=

ENV=production
